# Copy this file to deploy/.env on the server and fill in strong passwords.
# Passwords must not contain ';' because they end up in the connection string.
MYSQL_DATABASE=cargohub
MYSQL_USER=cargohub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# The school firewall lets 21, 22, 80, 443 and 8000-9000 through.
HTTP_PORT=80
