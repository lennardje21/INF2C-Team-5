# Copy this file to deploy/.env on the server and fill in strong passwords.
# Passwords must not contain ';' because they end up in the connection string.
MYSQL_DATABASE=cargohub
MYSQL_USER=cargohub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# The school firewall lets 21, 22, 80, 443 and 8000-9000 through.
HTTP_PORT=80

# Blockade detection (FR-7): minutes before an item counts as blocked, and how often to check.
# BLOCKADE_ENABLED=false switches the background job off.
# Optional: these defaults apply when a line is removed.
BLOCKADE_ENABLED=true
BLOCKADE_ORDER_MAX_MINUTES=120
BLOCKADE_SHIPMENT_MAX_MINUTES=240
BLOCKADE_TRANSFER_MAX_MINUTES=240
BLOCKADE_CHECK_INTERVAL_MINUTES=15

# Mail (FR-7.2) goes through Resend over SMTP.
# RESEND_API_KEY is secret: fill it in only in deploy/.env on the server, never in git.
# EMAIL_FROM must be an address on a domain verified in Resend; onboarding@resend.dev
# only works for testing and only delivers to the owner of the Resend account.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Uptime Kuma Socket.IO access for GET /metrics/uptime?SLA=99.99.
# Monitor the externally reachable /health endpoint. Use a login token OR credentials.
UPTIME_KUMA_URL=
UPTIME_KUMA_MONITOR_ID=0
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
UPTIME_KUMA_TOKEN=
