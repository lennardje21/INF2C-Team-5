# Copy this file to deploy/.env on the server and fill in strong passwords.
# Passwords must not contain ';' because they end up in the connection string.
MYSQL_DATABASE=cargohub
MYSQL_USER=cargohub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# The school firewall lets 21, 22, 80, 443 and 8000-9000 through.
HTTP_PORT=80

# Blockade detection (FR-7): minutes before an item counts as blocked, and how often to check.
# Optional: these defaults apply when a line is removed.
BLOCKADE_ORDER_MAX_MINUTES=120
BLOCKADE_SHIPMENT_MAX_MINUTES=240
BLOCKADE_TRANSFER_MAX_MINUTES=240
BLOCKADE_CHECK_INTERVAL_MINUTES=15